# Recon Agent — FastAPI Backend Environment Variables
# Copy this file to .env and fill in your values

# --- Supabase ---
# Found in: Supabase Dashboard → Settings → API
# SUPABASE_URL: Your project URL
SUPABASE_URL=https://rjwcqhxlvkphqqisfjrl.supabase.co
# SUPABASE_SERVICE_KEY: SERVICE_ROLE key (NOT publishable/anon key)
#   Go to Supabase Dashboard → Settings → API → "service_role" key (secret, "reveal" to view)
#   Format starts with "eyJ..." (JWT-style)
#   This bypasses RLS — needed for the backend to do org-scoped queries
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# --- Clerk ---
# Found in: Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Your Clerk Frontend API URL (derived from the publishable key)
# e.g. for pk_test_xxx.clerk.accounts.dev$ → https://xxx.clerk.accounts.dev
CLERK_ISSUER=https://merry-asp-3988.clerk.accounts.dev

# --- Encryption ---
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# This encrypts user-provided AI API keys before storing them in Supabase
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here
